# Earth-observation data logins. Copy this file to eoAccess.env (same folder), then fill in the values.
# eoAccess.env is never committed or deployed. Write each value exactly as it is: no quotes, no spaces around =.

# Copernicus Data Space Ecosystem (Sentinel-1, 2, 3, 5P). Register at https://dataspace.copernicus.eu/
CDSE_USER=your_copernicus_login_email_here
CDSE_PASS=your_copernicus_password_here

# NASA Earthdata Login (MODIS, PACE, EMIT, ECOSTRESS). Register at https://urs.earthdata.nasa.gov/users/new
EARTHDATA_USER=your_earthdata_username_here
EARTHDATA_PASS=your_earthdata_password_here
# A download token generated on your Earthdata profile page (https://urs.earthdata.nasa.gov/profile). Tokens expire, so renew it when it does.
EARTHDATA_TOKEN=your_earthdata_token_here
