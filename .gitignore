.env
spacetrack.env
__pycache__/
.pytest_cache/
*.db-wal
*.db-shm
~$*

# Working backup -- 0_tools/bugs.py writes it on every save
bugsDB.xlsx.bak

# Databases are never committed: each is rebuilt or kept current by its own
# ingestion job (news, orbital pipeline, GCAT, orbitStats), the live server
# keeps its own, and committed copies would republish Space-Track data.
# The one exception is groundSegmentAssets.db, which can't easily be rebuilt.
ingestionDBs/*
!ingestionDBs/groundSegmentAssets.db
